      VALUE "OriginalFilename", "ttp_ac3dts.dll\0"
      VALUE "ProductName", "TTPlayer Rebuild AC3DTS\0"
      VALUE "ProductVersion", "@AC3DTS_BUILD_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
